#!/usr/bin/env bash

REBOOT=0
FORCEREBOOT=0
SHUTDOWN=0
SLEEPTIME=10
SHUTDOWNTIME=1
UPGRADEMODE="full-upgrade"
AUTOREMOVE_SIMULATE=0
AUTOREMOVEOPT=""
ASSUMEYES=0
BASEINSTALL=(openssh-server debian-goodies)
DOBASEINSTALL=0
SHOWHELP=0
INSTALLPACKAGES=()
VERSION="1.3"
OPTIONLIST="hnrRSBy"

while getopts "$OPTIONLIST" opt; do
	case "$opt" in
		h) SHOWHELP=1 ;;
		n) UPGRADEMODE="upgrade"
		   AUTOREMOVE_SIMULATE=1
		   ;;
		r) REBOOT=1
		   AUTOREMOVE_SIMULATE=1
		   ;;
		R) FORCEREBOOT=1
		   AUTOREMOVE_SIMULATE=1
		   ;;
		S) SHUTDOWN=1
		   AUTOREMOVE_SIMULATE=1
		   ;;
		B) DOBASEINSTALL=1 ;;
		y) ASSUMEYES=1 ;;
	esac
done

if (( ASSUMEYES )); then
    AUTOREMOVEOPT="-y"
elif (( AUTOREMOVE_SIMULATE )); then
    AUTOREMOVEOPT="-s"
else
    AUTOREMOVEOPT=""
fi

shift $((OPTIND-1))

echo -e "\n *************************"
echo -e   " * gw APT-GET runner ${VERSION} *"
echo -e   " *************************\n"


if (( SHOWHELP )); then
	echo -e "Usage: $(basename $0) [-$OPTIONLIST] [package names]\n\n"
	echo -e "Options:\n"
	echo -e "\t-n Do normal upgrade instead of full-upgrade. Also autoremove will be just simulated and not executed.\n"
	echo -e "\t-r Reboot after script completed if necessary.\n"
	echo -e "\t-R Force reboot after script completed.\n"
	echo -e "\t-S Shutdown system ${SHUTDOWNTIME} minute(s) after script completed.\n"
	echo -e "\t-B Install basic packages: ${BASEINSTALL[@]}\n"
	echo -e "\t-y Assume yes on autoremove.\n"
	echo -e "\n[package names]: Install given packages.\n\n"

	exit 0
fi


if (( EUID != 0 )); then
	echo -e "Script must be run as root. Try 'sudo $0'\n"
	exit 1
fi


SUMOPTS=$((SHUTDOWN + FORCEREBOOT + REBOOT))

if (( SUMOPTS > 1 )); then
	echo -e "ERROR: Multiple use of options -r -R and -S!\nYou may only use one of it!\nAborting..\n"
	exit 1
fi

if (( SHUTDOWN )); then
	echo -e "SHUTDOWN option is set! Will shutdown system when finished!!\n"
elif (( FORCEREBOOT )); then
	echo -e "FORCE REBOOT option is set! Will reboot when finished.\n"
elif (( REBOOT )); then
	echo -e "REBOOT option is set! Will reboot if necessary when finished.\n"
fi

if (( DOBASEINSTALL )); then
	echo -e "BASE INSTALL option is set! Adding packets ${BASEINSTALL[@]} to install list.\n"
	INSTALLPACKAGES+=("${BASEINSTALL[@]}")
fi

if (( $# > 0 )); then
    INSTALLPACKAGES+=("$@")
fi

echo "Running UPDATE.."
if ! apt-get update; then
	echo "ERROR during apt-get update! Exiting.."
	exit 1
fi
echo -e "done.\n"

echo "Running ${UPGRADEMODE^^}.."

if ! apt-get -y $UPGRADEMODE; then
	echo "ERROR during apt-get ${UPGRADEMODE}! Exiting.."
	exit 1
fi
echo -e "done.\n"

if (( ${#INSTALLPACKAGES[@]} > 0 )); then
    printf 'Running INSTALL for: %s\n' "${INSTALLPACKAGES[*]}"

    if ! apt-get -y install "${INSTALLPACKAGES[@]}"; then
        echo "ERROR during apt-get install!"
        if (( DOBASEINSTALL )); then
            echo -e "Baseinstall or additional package installation failed. Exiting..\n"
            exit 1
        else
            echo -e "failed.\n"
        fi
    else
        echo -e "done.\n"
    fi
fi

echo "Running AUTOCLEAN.."
if ! apt-get autoclean; then
	echo "ERROR during autoclean!"
else
	echo -e "done.\n"
fi

echo "Running AUTOREMOVE.."
if ! apt-get $AUTOREMOVEOPT autoremove; then
	echo "ERROR during autoremove!"
else
	echo -e "done.\n"
fi

if (( ! FORCEREBOOT && ! SHUTDOWN )); then
	if command -v checkrestart >/dev/null 2>&1; then
		echo "Finally running CHECKRESTART to see what needs to be restarted.."
		checkrestart
		echo -e "done.\n"
	else
		echo "Skipping CHECKRESTART. Seems to be not available.."
	fi
fi

echo -e "** Finished APT-GET Runner! **\n"

DOREBOOT=0
MSG="Have a good day!"

if (( FORCEREBOOT )); then
	MSG="Rebooting in ${SLEEPTIME} seconds..."
	DOREBOOT=1	
elif (( REBOOT )); then
	if [[ -f /var/run/reboot-required ]]; then
		MSG="System reboot required. Rebooting in ${SLEEPTIME} seconds..."
		DOREBOOT=1
	else
		MSG="No reboot required. $MSG"
	fi	
fi

if (( SHUTDOWN )); then
	echo "Shutting down system in ${SHUTDOWNTIME} minute(s)..."
	shutdown -hP "+${SHUTDOWNTIME}"
elif (( DOREBOOT )); then
	echo "${MSG}"
	sleep "$SLEEPTIME"
	reboot
else
	echo "${MSG}"
fi